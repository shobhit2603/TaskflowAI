{
  "expo": {
    "name": "TaskflowAI",
    "slug": "taskflow-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "taskflow",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskflowai.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.taskflowai.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
