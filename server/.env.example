# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get your connection string from MongoDB Atlas > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=your_super_secret_jwt_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Web client origin (Next.js dev server or Vercel deployment URL)
CLIENT_URL=http://localhost:3000

# Multiple allowed origins (comma-separated, optional — falls back to CLIENT_URL)
# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── AI API ────────────────────────────────────────────────────────────────────
# Uncomment the provider you're using
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...

# ── Email (Reminders) ────────────────────────────────────────────────────────
# Resend (recommended) or nodemailer config
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@yourdomain.com
